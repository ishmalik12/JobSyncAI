# Copy to .env and set a MongoDB Atlas connection string before migrating.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DATABASE=jobsync_ai
# Generate a random secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_at_least_32_random_characters
JWT_EXPIRE_MINUTES=10080
FRONTEND_ORIGIN=http://localhost:5173
ENVIRONMENT=development
# Optional built-in refresh loop; 0 disables automatic refresh.
JOB_REFRESH_INTERVAL_HOURS=24
